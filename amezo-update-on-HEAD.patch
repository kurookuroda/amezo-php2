+def post(res, name, comm, subj=None):
+    d = dict(folder='adm', name=name, comm=comm)
+    if res: d['res'] = res
+    if subj: d['subj'] = subj
+    c, h, t = get('/amezo.cgi', q(**d), ip())
+    m = re.search(r'<h2>(.*?)</h2>', t); return c, (m.group(1) if m else '')
