+# 中継ページ (jump.php) の結合テスト (PHP 版だけ)。前提は lock_test.py と同じ
+import base64, os, random, re, shutil, sys, time, html, urllib.request, urllib.parse, urllib.error
+PH, URL = '/tmp/phpt', 'http://127.0.0.1:8123'
+bad = 0
